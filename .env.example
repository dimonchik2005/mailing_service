SECRET_KEY=my-secret-key
DEBUG=True

DB_NAME=mailing_service
DB_USER=postgres
DB_PASSWORD=my-password
DB_HOST=localhost
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=my-email@mail.ru
EMAIL_HOST_PASSWORD=my-application-password
DEFAULT_FROM_EMAIL=my-email@mail.ru

REDIS_URL=redis://127.0.0.1:6379/1
CACHE_TTL=60